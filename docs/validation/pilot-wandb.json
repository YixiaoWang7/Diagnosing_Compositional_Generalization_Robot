{
  "version": 1,
  "seed": 0,
  "features": {
    "features": [
      {
        "key": "actions",
        "shape": [
          7
        ],
        "source": "hdf5",
        "paths": [
          "actions"
        ],
        "cameras": [],
        "dtype": "float32",
        "normalization": "standard",
        "history": 0,
        "future": 15
      },
      {
        "key": "state",
        "shape": [
          9
        ],
        "source": "hdf5",
        "paths": [
          "obs/robot0_eef_pos",
          "obs/robot0_eef_quat",
          "obs/robot0_gripper_qpos"
        ],
        "cameras": [],
        "dtype": "float32",
        "normalization": "standard",
        "history": 0,
        "future": 0
      },
      {
        "key": "images",
        "shape": [
          3,
          256,
          256
        ],
        "source": "video",
        "paths": [],
        "cameras": [
          "agentview",
          "robot0_eye_in_hand"
        ],
        "dtype": "uint8",
        "normalization": "none",
        "history": 0,
        "future": 0
      }
    ]
  },
  "dataset": {
    "root": "/mnt/ssd/yixiao/cg/l4/single_stage_5demo",
    "video": {
      "decoder": "torchcodec",
      "max_handles": 8,
      "threads": 1
    },
    "sampling": {
      "strategy": "global_pass",
      "k_passes": 1,
      "seed": 42,
      "window_shards": 2,
      "block_size": 32,
      "prefetch_window": true,
      "prefetch_block": true
    },
    "selection": {
      "include_tasks": [],
      "exclude_tasks": [],
      "val_fraction": 0.01,
      "split_seed": 0,
      "subset_seed": 0,
      "max_demos": 80,
      "max_demos_per_task": null
    }
  },
  "loader": {
    "batch_size": 8,
    "num_workers": 2,
    "prefetch_factor": 2,
    "persistent_workers": true,
    "pin_memory": true,
    "multiprocessing_context": "spawn"
  },
  "policy": {
    "state_dim": 9,
    "action_dim": 7,
    "action_steps": 16,
    "obs_steps": 1,
    "cameras": 2,
    "entity_dim": 0,
    "selected_entities": 0,
    "conditioning": {
      "type": "learned",
      "num_tokens": 2
    },
    "fusion": {
      "type": "cross",
      "dim": 32,
      "heads": 4,
      "layers": 1,
      "ff_dim": 64,
      "dropout": 0.0,
      "mask": "none"
    },
    "vision": {
      "type": "patch",
      "patch_size": 8,
      "dim": 32,
      "depth": 12,
      "heads": 6,
      "image_size": 224,
      "freeze": false,
      "pretrained": null
    },
    "head": {
      "type": "conv",
      "down_dims": [
        32,
        64
      ],
      "time_dim": 32,
      "kernel_size": 5,
      "groups": 8
    },
    "algorithm": {
      "path_type": "linear",
      "scheduler_type": "uniform",
      "solver_type": "euler",
      "num_inference_steps": 10,
      "guidance_scale": 1.0,
      "velocity_clamp": null,
      "sigma_min": 0.0001,
      "sigma_schedule": "constant",
      "ot_reg": 0.05,
      "time_eps": 0.0,
      "t_max": 1.0,
      "logit_normal_loc": 0.0,
      "logit_normal_scale": 1.0,
      "dense_jump_density": 2.0,
      "beta_alpha": 1.5,
      "beta_beta": 1.0
    }
  },
  "processing": {
    "image_size": [
      64,
      64
    ],
    "crop_size": null,
    "random_crop": false,
    "image_mean": [
      0.485,
      0.456,
      0.406
    ],
    "image_std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "training": {
    "device": "cuda:0",
    "max_updates": 500,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "amp": true,
    "grad_clip_norm": 1.0,
    "schedule": "cosine",
    "warmup_updates": 0,
    "min_lr_ratio": 0.01,
    "log_every": 25,
    "validate_every": 250,
    "validation_batches": 10,
    "checkpoint_every": 250,
    "max_consecutive_skips": 100
  },
  "logging": {
    "out_dir": "runs/library-pilot-wandb-online",
    "wandb": {
      "enabled": true,
      "entity": "yixiao_wang",
      "project": "robopolicy-pilot",
      "name": "conv-recovery"
    }
  }
}
